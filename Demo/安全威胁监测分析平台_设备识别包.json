{
  "package_type": "eff-monitoring.device-rule-template-package",
  "package_version": "1.0",
  "exported_at": "2026-08-10T02:05:00Z",
  "source_device": {
    "name": "安全威胁监测分析平台",
    "vendor": "通用",
    "product": "安全威胁监测分析平台",
    "device_ip": "127.0.0.1",
    "version": "1.0",
    "device_role": "monitor"
  },
  "rules": [
    {
      "name": "安全威胁平台-事件ID",
      "field_key": "event_id",
      "field_label": "事件ID",
      "match_type": "regex",
      "pattern": "(?:日志ID|事件ID)\\s*[:：]?\\s*\\n?\\s*([A-Za-z0-9_-]{8,})",
      "priority": 50,
      "enabled": true,
      "match_all": false,
      "sample_log": ""
    },
    {
      "name": "安全威胁平台-告警设备",
      "field_key": "device_name",
      "field_label": "告警设备",
      "match_type": "regex",
      "pattern": "(?:采集设备序列号|传感器)\\s*[:：]?\\s*\\n?\\s*([A-Za-z0-9._-]+)",
      "priority": 51,
      "enabled": true,
      "match_all": false,
      "sample_log": ""
    },
    {
      "name": "安全威胁平台-告警名称",
      "field_key": "event_type",
      "field_label": "告警名称",
      "match_type": "regex",
      "pattern": "(?:威胁名称|事件名称)\\s*[:：]?\\s*\\n?\\s*([^\\n]+)",
      "priority": 52,
      "enabled": true,
      "match_all": false,
      "sample_log": ""
    },
    {
      "name": "安全威胁平台-攻击状态",
      "field_key": "attack_result",
      "field_label": "攻击状态",
      "match_type": "regex",
      "pattern": "攻击结果\\s*[:：]?\\s*\\n?\\s*(攻击成功|攻击失败|利用成功|利用失败|成功|失败|未知|无法确认)",
      "priority": 53,
      "enabled": true,
      "match_all": false,
      "sample_log": ""
    },
    {
      "name": "安全威胁平台-告警时间",
      "field_key": "alert_time",
      "field_label": "告警时间",
      "match_type": "regex",
      "pattern": "(?:告警时间|time)\\s*[:=：]?\\s*\\n?\\s*([0-9]{4}-[0-9]{2}-[0-9]{2}[ T][0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\+08:00)?)",
      "priority": 60,
      "enabled": true,
      "match_all": false,
      "sample_log": ""
    },
    {
      "name": "安全威胁平台-源IP",
      "field_key": "src_ip",
      "field_label": "源IP",
      "match_type": "regex",
      "pattern": "(?:攻击IP\\s*/\\s*源IP|攻击IP|源IP|src_ip)\\s*[:=：]?\\s*\\n?\\s*((?:\\d{1,3}\\.){3}\\d{1,3})",
      "priority": 61,
      "enabled": true,
      "match_all": false,
      "sample_log": ""
    },
    {
      "name": "安全威胁平台-目的IP",
      "field_key": "dst_ip",
      "field_label": "目的IP",
      "match_type": "regex",
      "pattern": "(?:受害IP\\s*/\\s*目的IP|受害IP|目的IP|dst_ip)\\s*[:=：]?\\s*\\n?\\s*((?:\\d{1,3}\\.){3}\\d{1,3})",
      "priority": 62,
      "enabled": true,
      "match_all": false,
      "sample_log": ""
    },
    {
      "name": "安全威胁平台-源端口",
      "field_key": "src_port",
      "field_label": "源端口",
      "match_type": "regex",
      "pattern": "(?:源端口|src_port)\\s*[:=：]?\\s*\\n?\\s*(\\d{1,5})",
      "priority": 70,
      "enabled": true,
      "match_all": false,
      "sample_log": ""
    },
    {
      "name": "安全威胁平台-目的端口",
      "field_key": "dst_port",
      "field_label": "目的端口",
      "match_type": "regex",
      "pattern": "(?:目的端口|dst_port)\\s*[:=：]?\\s*\\n?\\s*(\\d{1,5})",
      "priority": 71,
      "enabled": true,
      "match_all": false,
      "sample_log": ""
    },
    {
      "name": "安全威胁平台-攻击阶段",
      "field_key": "attack_stage",
      "field_label": "攻击阶段",
      "match_type": "regex",
      "pattern": "攻击阶段\\s*[:：]?\\s*\\n?\\s*([^\\n]+)",
      "priority": 72,
      "enabled": true,
      "match_all": false,
      "sample_log": ""
    },
    {
      "name": "安全威胁平台-HTTP请求方法",
      "field_key": "http_method",
