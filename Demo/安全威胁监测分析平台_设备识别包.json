      "match_all": false,
      "sample_log": ""
    },
    {
      "name": "安全威胁平台-会话ID",
      "field_key": "session_id",
      "field_label": "会话ID",
      "match_type": "regex",
      "pattern": "(?:会话ID|session_id)\\s*[:=：]?\\s*\\n?\\s*([A-Za-z0-9_-]+)",
      "priority": 76,
      "enabled": true,
      "match_all": false,
      "sample_log": ""
    },
    {
      "name": "安全威胁平台-日志ID",
      "field_key": "log_id",
      "field_label": "日志ID",
      "match_type": "regex",
      "pattern": "(?:日志ID|log_id)\\s*[:=：]?\\s*\\n?\\s*([A-Za-z0-9_-]+)",
      "priority": 77,
