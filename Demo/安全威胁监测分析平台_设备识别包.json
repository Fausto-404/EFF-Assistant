      "priority": 73,
      "enabled": true,
      "match_all": false,
      "sample_log": ""
    },
    {
      "name": "安全威胁平台-HTTP状态码",
      "field_key": "status_code",
      "field_label": "状态码",
      "match_type": "regex",
      "pattern": "(?:状态码|status_code)\\s*[:=：]?\\s*\\n?\\s*(\\d{3})",
      "priority": 74,
      "enabled": true,
      "match_all": false,
      "sample_log": ""
    },
    {
      "name": "安全威胁平台-URI",
      "field_key": "uri",
      "field_label": "URI",
      "match_type": "regex",
      "pattern": "(?:^|\\n)URI\\s*[:：]?\\s*\\n?\\s*([^\\s\\n]+)",
      "priority": 75,
